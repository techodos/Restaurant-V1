{
  "name": "restaurant-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/db/migrate.mjs",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:seed:zaytoun": "tsx scripts/db/zaytoun/seed/seed.ts",
    "db:create-staff": "tsx scripts/db/create-staff.ts",
    "db:reset": "node --env-file=.env.local scripts/db/migrate.mjs --fresh && tsx scripts/db/seed.ts",
    "db:verify": "tsx scripts/db/verify.ts",
    "notifications:dispatch": "tsx scripts/notifications/dispatch.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:verify:test": "VERIFY_DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/restaurant_platform_test VERIFY_DATABASE_URL_SERVICE=postgresql://app_service:app_service@localhost:5432/restaurant_platform_test VERIFY_DATABASE_URL_MIGRATOR=postgresql://app_owner:app_owner@localhost:5432/restaurant_platform_test tsx scripts/db/verify.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "firebase": "^12.19.0",
    "jose": "^5.9.6",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.4",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.14.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
