# Copy to .env.local. Every variable is read in src/server/config/index.ts only.

# --- Database (any Postgres, including Supabase) ------------------------------
# Runtime connection: the unprivileged role, so Row Level Security is enforced.
# Supabase: Project Settings -> Database -> Connection string (pooled, port 6543).
DATABASE_URL=
# Optional privileged connection for authorised server-side writes (guest checkout, admin mutations).
# When empty the runtime connection is used and the transaction switches role.
DATABASE_URL_SERVICE=
# Owner connection used only by scripts/db (migrate, seed, verify).
DATABASE_URL_MIGRATOR=
DB_POOL_MAX=10
# Optional session-mode (or direct) connection for Postgres LISTEN: live order tracking AND cross-process
# storefront cache invalidation (an admin save on one process reloads every process). Supabase: port 5432.
# Empty = no live order updates, and each process picks up admin changes on its scheduled cache refresh.
DATABASE_URL_LISTEN=

# --- Storefront cache (in-memory snapshot; an invalid value falls back to the default with a warning) ---
STOREFRONT_CACHE_ENABLED=true
# How often the snapshot (menu, branches, pages, settings, image URLs) is rebuilt. 1000..86400000 ms; default 5 min.
STOREFRONT_CACHE_REFRESH_INTERVAL_MS=300000
# Longest a single snapshot load may take (the first one failing fails startup). 1000..600000 ms; default 60 s.
STOREFRONT_CACHE_STARTUP_TIMEOUT_MS=60000

# --- Auth ---------------------------------------------------------------------
# HS256 key for session JWTs (HttpOnly cookies). At least 16 characters; use a long random value.
AUTH_SECRET=

# --- App ----------------------------------------------------------------------
# Public origin every email / push / payment-return link is built on. REQUIRED in production (no localhost fallback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The ONE restaurant this deployment serves (its slug), at root-level URLs: /, /menu, /checkout, /admin.
# REQUIRED in production; development falls back to bella-napoli.
NEXT_PUBLIC_DEFAULT_RESTAURANT=bella-napoli
# Storefront template for this deployment (presentation only; same pages, routes and content):
#   1 = Classic 2D (default; cafés, dining rooms)
#   2 = 3D (live 3D hero + depth across pages; burger / Gen Z brands)
#   3 = placeholder slot (renders Classic 2D until its design is specified)
# Unset or any other value falls back to 1 and logs a warning. Restart the server after changing it.
TEMPLATE_ID=1

# --- Media storage (optional: local .uploads/ is used when unset) --------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=restaurant-media

# --- Online payments (optional: cash only when unset) --------------------------
# Stripe Checkout (card). Test-mode keys are free and instant at https://dashboard.stripe.com
# (Developers > API keys) — no business verification needed for test mode. A restaurant also
# needs settings.payments.onlineProvider = "stripe" (admin settings) before "Card (online)"
# appears at checkout. STRIPE_WEBHOOK_SECRET is optional but recommended — see SKILL.md section 18.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# JazzCash Hosted Checkout Page (Mobile Wallet). All three required together; a restaurant also
# needs settings.payments.onlineProvider = "jazzcash" (admin settings) before "Wallet" appears at
# checkout. Get these from JazzCash's sandbox merchant onboarding — see SKILL.md section 18.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox

# --- Notifications (optional: emails/push are skipped, never failed, when unset) -----
# Secret (16+ chars) for POST /api/internal/notifications/dispatch, called by a scheduler.
NOTIFICATIONS_DISPATCH_SECRET=
# Queued notifications older than this are dropped instead of being sent late.
NOTIFICATION_MAX_AGE_HOURS=24
# How often `npm run notifications:dispatch -- --loop` polls for due events (dev only).
NOTIFICATIONS_DISPATCH_INTERVAL_MS=5000

# --- Customer "Continue with Google" (optional: the button is hidden when unset) -----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/account/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Checkout delivery-location map (optional: falls back to plain text address fields when unset) ---
# Google Cloud Console -> APIs & Services -> Credentials -> API key. Enable these APIs on the project:
#   Maps JavaScript API, Places API
# (Geocoding API is NOT needed — reverse geocoding uses OpenStreetMap Nominatim, below.)
# Restrict the key to HTTP referrers for this site (your domain + localhost while developing).
# This key is sent to the browser by design (Google Maps keys are restricted by referrer, not secret).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Reverse geocoding (address lookup for the delivery-location picker) ---
# Defaults to the public OpenStreetMap Nominatim instance; point this at a self-hosted instance instead
# if you need higher volume (public instance usage policy: 1 request/second, no bulk use).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires identifying the app/operator in requests. Set to a contact
# email or URL; defaults to NEXT_PUBLIC_SITE_URL if left blank.
NOMINATIM_CONTACT=
