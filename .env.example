# ---------------------------------------------------------------------------
# Database — works with ANY Postgres, including Supabase.
# Supabase: Project Settings -> Database -> Connection string (use the pooled
# "Transaction" string for serverless/Vercel, port 6543).
# The role MUST be the non-owner runtime role so Row Level Security is enforced.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://app_runtime:app_runtime@localhost:5432/restaurant_platform"
# Direct (owner) connection used only by migration/seed scripts
DATABASE_URL_MIGRATOR="postgresql://app_owner:app_owner@localhost:5432/restaurant_platform"

# ---------------------------------------------------------------------------
# Auth — sessions are HS256 JWTs in HttpOnly cookies.
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-32-byte-random-string"

# ---------------------------------------------------------------------------
# Supabase (optional). When present the app uses Supabase Auth + Storage +
# Realtime instead of the built-in local providers. Leave empty to run fully
# local against Postgres only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="restaurant-media"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public default restaurant slug used by the platform landing page
NEXT_PUBLIC_DEFAULT_RESTAURANT="bella-napoli"
