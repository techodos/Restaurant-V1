# Copy to .env.local. Every variable is read in src/server/config/index.ts only.

# --- Database (any Postgres, including Supabase) ------------------------------
# Runtime connection: the unprivileged role, so Row Level Security is enforced.
# Supabase: Project Settings -> Database -> Connection string (pooled, port 6543).
DATABASE_URL=
# Optional privileged connection for authorised server-side writes (guest checkout, admin mutations).
# When empty the runtime connection is used and the transaction switches role.
DATABASE_URL_SERVICE=
# Owner connection used only by scripts/db (migrate, seed, verify).
DATABASE_URL_MIGRATOR=
DB_POOL_MAX=10

# --- Auth ---------------------------------------------------------------------
# HS256 key for session JWTs (HttpOnly cookies). At least 16 characters; use a long random value.
AUTH_SECRET=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Restaurant served at "/" until custom domains are wired up. It is also the one restaurant this
# instance serves when the storefront cache is on: the cache loads it at startup and any other
# /r/<slug> returns 404.
NEXT_PUBLIC_DEFAULT_RESTAURANT=bella-napoli

# --- Storefront cache (in-memory, per process) --------------------------------
# On startup the storefront's public data (restaurant, website, menu, locations, delivery zones,
# reviews) is loaded into memory and storefront pages read it without touching the database.
# Carts, checkout, orders, payments, reservations and customer data always use the database.
# false = every storefront read queries the database, as before (rollback/debug switch).
STOREFRONT_CACHE_ENABLED=true
# Delay between the end of one background refresh and the start of the next (1000-86400000).
# Data edited in the database appears on the storefront within about this long.
STOREFRONT_CACHE_REFRESH_INTERVAL_MS=300000
# Upper bound for one snapshot load (1000-600000). The first load exceeding it (or failing) stops
# the server from starting; a later refresh exceeding it is abandoned and the old snapshot stays.
STOREFRONT_CACHE_STARTUP_TIMEOUT_MS=60000

# --- Media storage (optional: local .uploads/ is used when unset) --------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=restaurant-media

# --- Online payments (optional: cash only when unset) --------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Customer emails (Resend; optional: no email is sent when unset) ------------
RESEND_API_KEY=
# Must be a sender verified in Resend; onboarding@resend.dev only delivers to your own Resend account address.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_MAX_PER_SECOND=2

# --- Push notifications (Firebase Cloud Messaging; optional) --------------------
# Server side (service account).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Browser side (Firebase web app config; public by design).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Notification dispatch -----------------------------------------------------
# Bearer secret for POST /api/internal/notifications/dispatch (16+ characters). Unset = endpoint disabled.
NOTIFICATIONS_DISPATCH_SECRET=
# Undelivered notifications older than this are dropped (1-168).
NOTIFICATION_MAX_AGE_HOURS=24

# --- Live order status (SSE over Postgres LISTEN/NOTIFY) ------------------------
# Session-mode connection (Supabase: port 5432). LISTEN does not work through the transaction pooler.
DATABASE_URL_LISTEN=
